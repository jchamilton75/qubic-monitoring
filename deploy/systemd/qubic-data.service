[Unit]
Description=QUBIC data synchronizer and SQLite collector
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Type=simple
User=hamilton
WorkingDirectory=/srv/qubic/qubic-monitoring
Environment=QUBIC_REFRESH_SECONDS=120
ExecStart=/usr/bin/npm run data:watch
Restart=always
RestartSec=15s
KillSignal=SIGTERM
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
